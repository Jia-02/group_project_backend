<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.GroupProject.dao.TablesDao">


	<!-- 對應 DTO 欄位的 resultMap -->
	<resultMap id="TableMap"
		type="com.example.GroupProject.dto.TablesDto">


		<result property="tableId" column="table_id" />    
		<result property="tableStatus" column="table_status" />   
		<result property="tableCapacity" column="capacity" />      
		<result property="tablePositionX" column="position_x" />      
		<result property="tablePositionY" column="position_y" />    


	</resultMap>

	<!-- 新增桌位 -->
	<insert id="addTable"
			parameterType="com.example.GroupProject.dto.TablesDto">
			INSERT INTO tables (table_id,table_status,capacity,position_x,position_y)
			VALUES (#{tableId} , #{tableStatus}, #{tableCapacity}, #{tablePositionX}, #{tablePositionY})

	</insert>

	<!-- 取得桌位列表 -->
	<select id="getTableList" resultMap="TableMap">
		select * from tables
	</select>
	
	<!-- 透過id查詢桌位是否仍存在 -->
	<select id="existsById" resultType="boolean">
		SELECT COUNT(1) > 0 from
		tables
		WHERE table_id = #{tableId}
	</select>

	<!-- 更新桌位狀態 -->
	<update id="updateTableStatus">
		UPDATE tables
		SET table_status = #{tableStatus}
		WHERE table_id = #{tableId}
	</update>

	
	<delete id="delTableByTableId"
			parameterType="com.example.GroupProject.dto.TablesDto">
		delete from tables where table_id = #{tableId}
	</delete>
	
	<update id="updateByTableId"
			parameterType="com.example.GroupProject.dto.TablesDto">
		update tables set table_status = #{tableStatus}, capacity = #{tableCapacity} ,
			position_x = #{tablePositionX}, position_y = #{tablePositionY} where table_id = #{tableId}
			
	</update>

</mapper>