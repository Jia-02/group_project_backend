<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.GroupProject.dao.AccountDao">
	<insert id="addAccount">
		INSERT INTO delivery_user
		(user_name,password,name,phone) VALUES (
		#{userName}, #{password},
		#{name}, #{phone} )
	</insert>

	<select id="selectCountByUserName" resultType="int">
		SELECT
		COUNT(user_name)
		FROM delivery_user
		WHERE user_name = #{userName}
	</select>

	<select id="selectByUserName"
		resultType="com.example.GroupProject.dto.Account">
		SELECT
		id,
		user_name,
		password,
		name,
		phone
		FROM delivery_user
		WHERE user_name = #{userName}
		</select>
		
	<select id="selectNameByUserName"
		resultType="com.example.GroupProject.dto.Account">
		SELECT
		name,
		phone
		FROM delivery_user
		WHERE user_name = #{userName}
	</select>


	

</mapper>